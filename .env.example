# --- Server (apps/server) — อ่านโดย zod ตอน boot, ค่าที่ขาดจะ fail-fast ---
# PostgreSQL 16 (compose: postgres service)
DATABASE_URL=postgres://music:music@localhost:5432/musicplayer

PORT=3001
CORS_ORIGIN=http://localhost:5173

# Lavalink v4.2.2 (compose: lavalink service)
LAVALINK_URL=http://localhost:2333
LAVALINK_PASSWORD=youshallnotpass

# Spotify (ใช้โดย LavaSrc plugin ฝั่ง Lavalink — spsearch เท่านั้น ไม่มีเสียง)
# สร้าง app ที่ https://developer.spotify.com/dashboard → copy Client ID/Secret
# ว่างได้ แต่ spsearch จะใช้ไม่ได้จนกว่าจะตั้งค่าจริง
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Resolver service แยก container (compose: resolver) — implement จริงใน Phase 3
RESOLVER_URL=http://localhost:3002

# ความยาวอย่างน้อย 32 ตัวอักษร, สุ่มเฉพาะตัว — ห้ามใช้ค่าจากไฟล์นี้จริง
JWT_SECRET=change-me-32-chars-minimum-dev-only
REFRESH_SECRET=change-me-32-chars-minimum-dev-only
