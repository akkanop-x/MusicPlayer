    "@fastify/cors": "^11.0.0",
    "@musicplayer/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.3.0",
    "pg": "^8.16.0",
    "socket.io": "^4.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "socket.io-client": "^4.8.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
